# Conscience Research production service environment
CONSCIENCE_HOST=0.0.0.0
CONSCIENCE_PORT=8080

# Service starts in baseline oracle mode for evaluation endpoints.
# Override per request when needed.
CONSCIENCE_ORACLE_MODE=baseline
CONSCIENCE_SCENARIO_EDIT_MODE=off

# Admin authorisation for state-changing endpoints
# (POST /v1/reset, POST /v1/norms/threshold, and mutating /v1/guardrail/decision or /v1/chat calls).
# When set, callers must send "Authorization: Bearer <token>".
# When unset, only loopback clients (127.0.0.1 / ::1) may change state.
CONSCIENCE_ADMIN_TOKEN=
# Local Docker development only: trust every client for state changes.
# Never enable this in a shared or production deployment.
CONSCIENCE_ALLOW_UNAUTH_ADMIN=0

# Decision audit file (hash-chained JSONL, verify with GET /v1/audit/verify)
CONSCIENCE_AUDIT_FILE=decision_audit.jsonl
